# Vorlage. Kopieren nach .env und die Platzhalter ersetzen:
#   cp .env.beispiel .env
# Passwort erzeugen:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo

POSTGRES_DB=kajoe_bilder
POSTGRES_USER=kajoe
POSTGRES_PASSWORD=hier-das-echte-passwort-eintragen

# Nur auf dem Rechner selbst erreichbar – siehe docker-compose.yml
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Fuer Anwendungen, die eine fertige Verbindungszeichenkette erwarten
DATABASE_URL=postgresql://kajoe:hier-das-echte-passwort-eintragen@127.0.0.1:5432/kajoe_bilder
