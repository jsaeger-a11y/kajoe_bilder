# Vorlage. Kopieren nach .env und die Platzhalter ersetzen:
#   cp .env.beispiel .env
# Passwort erzeugen:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo

POSTGRES_DB=kajoe_bilder
POSTGRES_USER=kajoe
POSTGRES_PASSWORD=hier-das-echte-passwort-eintragen

# Nur auf dem Rechner selbst erreichbar – siehe docker-compose.yml
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Eine fertige Verbindungszeichenkette steht hier ABSICHTLICH nicht. Sie
# enthielte das Passwort ein zweites Mal, und zwei Stellen mit demselben
# Geheimnis sind zwei Staende. Genau daran hing die Anwendung am 31.08.2026
# stundenlang unbemerkt. Wer eine URL braucht, setzt sie aus den Werten
# darueber zusammen – datenbank.datenbank_url() in Python,
# datenbankUrl() in web/src/lib/umgebung.ts.


# Weboberflaeche
# --------------
# `Secure` am Sitzungscookie heisst: nur ueber HTTPS. Im lokalen Netz laeuft
# die Anwendung ueber http://webspace:3000, und dann kommt das Cookie NIE an –
# die Anmeldung schlaegt scheinbar grundlos fehl. `localhost` gilt als sicherer
# Kontext, ein Hostname im LAN nicht.
#
# Vorgabe im Code ist AN. Ohne diese Zeile laeuft die Anwendung also mit
# Secure. Nur fuer das lokale Netz auf 0 setzen; dann schreibt die Anwendung
# beim Start eine deutliche Warnung ins Log.
#
# Spaetestens mit dem Cloudflare Tunnel gehoert hier wieder 1 hin.
COOKIE_SECURE=1


# Aufraeumlauf
# ------------
# Der Aufraeumlauf ist der EINZIGE Vorgang im System, der Dateien wirklich
# entfernt. Der Timer (kajoe-aufraeumen.timer, taeglich 03:20 UTC) ruft
# `tools/aufraeumen.sh --timer` auf und liest den Modus HIER – nicht im Skript
# und nicht in der Unit. Die Umstellung auf scharf ist damit eine Zeile und
# braucht kein `daemon-reload`, das jemand vergisst.
#
#   0 (oder Zeile fehlt)  Probelauf: zaehlen und berichten, nichts entfernen
#   1                     wirklich entfernen
#
# Vorsichtig anfangen: erst ein paar Naechte Probelauf, die Berichte in
# `tools/status.sh` ansehen, dann auf 1.
#
# Ein Aufruf VON HAND ist davon unberuehrt: `tools/aufraeumen.sh` loescht wie
# bisher, `tools/aufraeumen.sh --probe` zaehlt nur.
AUFRAEUMEN_SCHARF=0
